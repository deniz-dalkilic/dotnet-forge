{
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=dotnetforge;Username=dotnetforge;Password=dotnetforge",
    "EnableSensitiveDataLogging": false,
    "ApplyMigrationsOnStartup": true
  },
  "Caching": {
    "Enabled": true,
    "Hybrid": {
      "DefaultEntryExpiration": "00:05:00",
      "LocalCacheExpiration": "00:02:00",
      "MaximumPayloadBytes": 1048576,
      "MaximumKeyLength": 1024
    },
    "Distributed": {
      "Enabled": false,
      "Provider": null,
      "ConnectionString": null,
      "InstanceName": "dotnetforge"
    }
  },
  "Hangfire": {
    "ConnectionString": null,
    "SchemaName": "hangfire",
    "DashboardPath": "/hangfire",
    "EnableDashboard": true,
    "QueueJobsViaApi": true,
    "Server": {
      "Queues": [
        "default"
      ],
      "WorkerCount": 4
    },
    "RecurringJobs": {
      "Enabled": true,
      "HeartbeatCron": "*/5 * * * *"
    }
  },
  "Observability": {
    "Seq": {
      "Enabled": true,
      "ServerUrl": "http://localhost:5341",
      "ApiKey": null
    },
    "OpenTelemetry": {
      "Enabled": true,
      "Otlp": {
        "Enabled": false,
        "Endpoint": null,
        "Protocol": "grpc",
        "Headers": {}
      }
    },
    "Redaction": {
      "SensitiveHeaders": [
        "Authorization",
        "Cookie",
        "Set-Cookie",
        "X-Api-Key"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
