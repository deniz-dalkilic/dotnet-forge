{
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=dotnetforge;Username=dotnetforge;Password=dotnetforge",
    "EnableSensitiveDataLogging": false,
    "ApplyMigrationsOnStartup": false
  },
  "Caching": {
    "Enabled": true
  },
  "Hangfire": {
    "ConnectionString": null,
    "SchemaName": "hangfire",
    "DashboardPath": "/hangfire",
    "EnableDashboard": false,
    "QueueJobsViaApi": false,
    "Server": {
      "Queues": [ "default" ],
      "WorkerCount": 4
    },
    "RecurringJobs": {
      "Enabled": true,
      "HeartbeatCron": "*/5 * * * *"
    }
  },
  "Observability": {
    "Seq": {
      "Enabled": true,
      "ServerUrl": "http://localhost:5341",
      "ApiKey": null
    },
    "OpenTelemetry": {
      "Enabled": true,
      "Otlp": {
        "Enabled": false,
        "Endpoint": null,
        "Protocol": "grpc",
        "Headers": {}
      }
    },
    "Redaction": {
      "SensitiveHeaders": [ "Authorization", "Cookie", "Set-Cookie", "X-Api-Key" ]
    }
  }
}
